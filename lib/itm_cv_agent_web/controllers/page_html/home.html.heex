<Layouts.app flash={@flash}>
  <div class="min-h-[calc(100vh-12rem)] flex items-center">
    <div class="w-full">
      <div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight leading-tight">
          Skriv dine projekterfaringer <span class="text-secondary">hurtigere</span>
          og <span class="text-accent">bedre</span>
        </h1>

        <p class="mt-6 text-lg text-base-content/70 leading-relaxed">
          CV Agent hjælper dig med at formulere dine projekterfaringer gennem en guidet samtale.
          Få professionelle, præcise beskrivelser på minutter.
        </p>

        <div class="mt-8 flex flex-wrap gap-4">
          <.link
            navigate={~p"/conversations/new"}
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-secondary text-secondary-content font-semibold hover:opacity-90 transition-opacity"
          >
            <.icon name="hero-plus" class="size-5" /> Start ny samtale
          </.link>

          <.link
            navigate={~p"/conversations"}
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl border border-base-300 bg-base-100 font-semibold hover:bg-base-200 transition-colors"
          >
            <.icon name="hero-chat-bubble-left-right" class="size-5" /> Se samtaler
          </.link>
        </div>
      </div>
    </div>
  </div>
</Layouts.app>
